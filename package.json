{
  "name": "esp32-servo-control",
  "version": "1.0.0",
  "description": "ESP32 Servo Control Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder build --win",
    "build-portable": "electron-builder build --win portable"
  },
  "keywords": ["esp32", "servo", "firebase"],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.esp32.servocontrol",
    "productName": "ESP32 Servo Control",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "icon.ico"
    },
    "files": [
      "main.js",
      "index.html",
      "icon.png"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
